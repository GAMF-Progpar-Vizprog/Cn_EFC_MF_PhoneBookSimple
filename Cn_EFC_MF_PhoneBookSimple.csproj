<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Cn-EFC-MF-PhoneBookSimple</AssemblyName>
    <RootNamespace>Cn-EFC-MF-PhoneBookSimple</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="dmPhoneBook.Diagram1.view">
      <AutoGen>True</AutoGen>
      <DependentUpon>dmPhoneBook.efml</DependentUpon>
    </None>
    <None Update="dmPhoneBook.edps">
      <AutoGen>True</AutoGen>
      <DependentUpon>dmPhoneBook.efml</DependentUpon>
    </None>
    <None Update="dmPhoneBook.efml">
      <Generator>DevartEFCoreGenerator</Generator>
      <LastGenOutput>dmPhoneBook.info</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
